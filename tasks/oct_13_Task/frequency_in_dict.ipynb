   "source": [
    "2. Find the frequency of every element using a dictionary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "5426c6fb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{5: 3, 4: 4, 6: 1, 7: 1, 8: 1, 3: 2}\n"
     ]
    }
   ],
   "source": [
    "l1 = [5, 4, 5, 4, 6, 7, 8, 4, 3, 5, 3, 4]\n",
    "\n",
    "freq_ele = {}\n",
    "\n",
    "for i in l1:\n",
    "    if i in freq_ele:\n",
    "        freq_ele[i] += 1\n",
    "    else:\n",
    "        freq_ele[i] = 1\n",
    "\n",
    "print(freq_ele)"
   ]
  }
